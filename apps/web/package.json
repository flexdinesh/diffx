{
  "name": "@diffx/web",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build --logLevel warn",
    "dev": "vite",
    "test": "pnpm test:unit && pnpm test:browser",
    "test:unit": "node --test --test-reporter=dot test/*.test.ts && pnpm test:dom",
    "test:dom": "node --import tsx --import ./test/dom/setup.ts --test --test-reporter=dot test/dom/*.test.ts",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json"
  },
  "dependencies": {
    "@diffx/api": "workspace:*",
    "@diffx/ui": "workspace:*",
    "@pierre/diffs": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/react": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "pg": "^8.23.1",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "webmcp-types": "catalog:"
  }
}
