{
  "name": "@diffx/console",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build --logLevel warn",
    "dev": "vite",
    "test": "mise -C ../.. run test:js",
    "test:dom": "mise -C ../.. run check:unit",
    "test:browser": "mise -C ../.. run check:browser",
    "test:exec:dom": "node --import tsx --import ./test/dom/setup.ts --test --test-reporter=dot test/dom/*.test.ts",
    "test:exec:browser": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@diffx/console-api": "workspace:*",
    "@diffx/ui": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/react": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "pg": "^8.23.1",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
