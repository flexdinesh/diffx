{
  "name": "diffx-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm generate:api && pnpm --filter @diffx/web build",
    "dev:web": "pnpm --filter @diffx/web dev",
    "generate:api": "pnpm --filter @diffx/api generate",
    "typecheck": "pnpm --recursive --if-present typecheck && tsc --noEmit -p test/tsconfig.json",
    "test": "pnpm --recursive --if-present test",
    "test:web": "pnpm --filter @diffx/web test",
    "test:go": "go test -timeout 3m ./...",
    "test:release": "node --test test/release/*.test.ts",
    "test:conformance": "node --test test/conformance/*.test.ts",
    "test:browser:install": "pnpm --filter @diffx/web test:browser:install",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "generate:homebrew": "node tools/generate-homebrew-formula.ts",
    "check:static": "pnpm typecheck && pnpm lint && pnpm format:check",
    "check:js": "pnpm check:static && pnpm build && pnpm test && pnpm test:release",
    "check:ci": "mise run check:ci",
    "check:push": "mise run check:push",
    "check": "mise run check"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "pg": "^8.23.1",
    "typescript": "catalog:",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@11.25.0"
}
