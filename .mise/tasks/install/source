#!/usr/bin/env bash
#MISE description="Build the CLI from this checkout with dev version metadata at OUTPUT"
#MISE depends=["deps", "web:stage"]

set -euo pipefail
output="${1:?usage: mise run install:source -- OUTPUT}"
package=github.com/flexdinesh/diffx/internal/version
commit="$(git rev-parse HEAD)"
date="$(git show -s --format=%cI HEAD)"
# Without VCS stamping Go keeps Version=dev instead of deriving a pseudo-version.
go build -trimpath -buildvcs=false \
  -ldflags "-X $package.Version=dev -X $package.Commit=$commit -X $package.Date=$date" \
  -o "$output" ./cmd/diffx
