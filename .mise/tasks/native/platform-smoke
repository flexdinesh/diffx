#!/bin/sh
#MISE description="Exercise actual macOS/Linux desktop windows, clipboard and local server"
#MISE depends=["native:build"]
set -eu
case "$(go env GOOS)" in
  darwin) ;;
  linux) export MYGO_GPU=0 GDK_BACKEND=x11 ;;
  *) printf '%s\n' 'Native platform smoke supports macOS and Linux.' >&2; exit 1 ;;
esac
go -C apps/desktop build -mod=readonly -tags nativeautomation \
  -o build/acceptance/diffx-native ./cmd/diffx-native
go build -o dist/diffx-native-driver ./test/native/cmd/native-driver
export DIFFX_NATIVE_ACCEPTANCE=1
export DIFFX_NATIVE_BINARY=$PWD/apps/desktop/build/acceptance/diffx-native
export DIFFX_NATIVE_SIDECAR=$PWD/apps/desktop/build/dev/diffx
export DIFFX_NATIVE_DRIVER=$PWD/dist/diffx-native-driver
exec go test -count=1 -timeout=180s -v ./test/native/...
