#!/usr/bin/env bash
#MISE description="Select release version and export workflow outputs"
#MISE tools={ "aqua:cli/cli" = "2.103.0" }

set -euo pipefail
: "${GITHUB_OUTPUT:?GITHUB_OUTPUT is required}"

git fetch --tags --force
release_version="$(go run ./tools/release-version)"
tag_exists=false
if git rev-parse --verify --quiet "refs/tags/$release_version" >/dev/null; then
  # Release tags point at an asset commit whose first parent is main.
  tag_parent="$(git rev-parse --verify "$release_version^1")"
  head_commit="$(git rev-parse HEAD)"
  if [[ "$tag_parent" != "$head_commit" ]]; then
    echo "$release_version was released from $tag_parent, not current main $head_commit" >&2
    exit 1
  fi
  tag_exists=true
fi

release_exists=false
if gh release view "$release_version" >/dev/null 2>&1; then
  release_exists=true
fi

{
  echo "tag=$release_version"
  echo "number=${release_version#v}"
  echo "tag_exists=$tag_exists"
  echo "release_exists=$release_exists"
} >> "$GITHUB_OUTPUT"
