#!/usr/bin/env bash
#MISE description="Publish the selected stable source release"
#MISE tools={ "aqua:cli/cli" = "2.103.0" }

set -euo pipefail
: "${RELEASE_TAG:?RELEASE_TAG is required}"
: "${DIFFX_SOURCE_SHA:?DIFFX_SOURCE_SHA is required}"
: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"

git rev-parse --verify "refs/tags/$RELEASE_TAG^{commit}" >/dev/null
if [[ "$(go run ./tools/release-version)" != "$RELEASE_TAG" ]]; then
  echo "$RELEASE_TAG does not match the selected source release" >&2
  exit 1
fi
published_tags="$(gh api --paginate "repos/$GITHUB_REPOSITORY/releases" --jq '.[] | select(.draft == false) | .tag_name')"
if grep -Fxq -- "$RELEASE_TAG" <<< "$published_tags"; then
  echo "$RELEASE_TAG is already published"
  exit 0
fi
export DIFFX_RELEASE_VERSION="${RELEASE_TAG#v}"
mise run release:package

release_tags="$(gh api --paginate "repos/$GITHUB_REPOSITORY/releases" --jq '.[].tag_name')"
notes="Source commit: $DIFFX_SOURCE_SHA"
if grep -Fxq -- "$RELEASE_TAG" <<< "$release_tags"; then
  gh release upload "$RELEASE_TAG" dist/*.tar.gz --clobber
  gh release upload "$RELEASE_TAG" dist/checksums.txt --clobber
  gh release edit "$RELEASE_TAG" --title "$RELEASE_TAG" --notes "$notes" --prerelease=false --latest --draft=false
else
  gh release create "$RELEASE_TAG" dist/*.tar.gz dist/checksums.txt --verify-tag --title "$RELEASE_TAG" --notes "$notes" --generate-notes --latest
fi
