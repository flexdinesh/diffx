#!/usr/bin/env bash
#MISE description="Publish the current main source as the rolling edge prerelease"
#MISE tools={ "aqua:cli/cli" = "2.103.0" }

set -euo pipefail
: "${GITHUB_SHA:?GITHUB_SHA is required}"
: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"

candidate="$(git rev-parse --verify "$GITHUB_SHA^{commit}")"
if [[ "$(git rev-parse HEAD)" != "$candidate" ]]; then
  echo "edge checkout does not match $candidate" >&2
  exit 1
fi

git fetch --no-tags origin '+refs/heads/main:refs/remotes/origin/main'
if [[ "$(git rev-parse refs/remotes/origin/main)" != "$candidate" ]]; then
  echo "skip stale edge build $candidate"
  exit 0
fi

export DIFFX_RELEASE_VERSION=edge
export DIFFX_SOURCE_SHA="$candidate"
mise run release:package

# Main can advance during compilation. Reject a stale build before publication.
git fetch --no-tags origin '+refs/heads/main:refs/remotes/origin/main'
if [[ "$(git rev-parse refs/remotes/origin/main)" != "$candidate" ]]; then
  echo "skip stale edge publication $candidate"
  exit 0
fi

release_tags="$(gh api --paginate "repos/$GITHUB_REPOSITORY/releases" --jq '.[].tag_name')"
current_edge="$(git ls-remote --tags origin refs/tags/edge | cut -f1)"
git push --no-verify --force-with-lease="refs/tags/edge:$current_edge" origin "$candidate:refs/tags/edge"

notes="Rolling edge build. Source commit: $candidate"
if grep -Fxq edge <<< "$release_tags"; then
  gh release upload edge dist/*.tar.gz --clobber
  gh release upload edge dist/checksums.txt --clobber
  gh release edit edge --title Edge --notes "$notes" --target "$candidate" --prerelease --latest=false --draft=false
else
  gh release create edge dist/*.tar.gz dist/checksums.txt --verify-tag --title Edge --notes "$notes" --prerelease --latest=false
fi

# Desktop publishing runs separately only after this candidate actually ships.
if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
  printf 'desktop_source=%s\n' "$candidate" >> "$GITHUB_OUTPUT"
fi
