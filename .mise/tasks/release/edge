#!/usr/bin/env bash
#MISE description="Publish a main commit plus embedded web assets to the edge branch"

set -euo pipefail
: "${GITHUB_SHA:?GITHUB_SHA is required}"

git fetch --force --tags origin '+refs/heads/*:refs/remotes/origin/*'
candidate="$(git rev-parse --verify "$GITHUB_SHA^{commit}")"

current_edge=""
if current_edge="$(git rev-parse --verify --quiet refs/remotes/origin/edge)"; then
  if git merge-base --is-ancestor "$candidate" "$current_edge^1"; then
    echo "edge already includes $candidate"
    exit 0
  fi
fi

# Release commits are not ancestors of main. Adding the latest one as a parent
# makes Go derive edge pseudo-versions that sort after that release.
parents=("$candidate")
latest_release="$(git tag --list 'v[0-9]*' --sort=-v:refname | sed -n 1p)"
if [[ -n "$latest_release" ]] && ! git merge-base --is-ancestor "$latest_release" "$candidate"; then
  parents+=("$latest_release")
fi

edge_commit="$(tools/asset-commit.sh "edge: $candidate" "${parents[@]}")"
git push --no-verify --force-with-lease="refs/heads/edge:$current_edge" origin "$edge_commit:refs/heads/edge"
