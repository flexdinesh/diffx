#!/usr/bin/env bash
#MISE description="Build release archives and checksums without publishing"
#MISE tools={ "aqua:goreleaser/goreleaser" = "2.18.2" }

set -euo pipefail
: "${DIFFX_RELEASE_VERSION:?DIFFX_RELEASE_VERSION is required}"
: "${DIFFX_SOURCE_SHA:?DIFFX_SOURCE_SHA is required}"

if [[ "$(git rev-parse HEAD)" != "$DIFFX_SOURCE_SHA" ]]; then
  echo "release checkout does not match source $DIFFX_SOURCE_SHA" >&2
  exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
  echo "release source must be clean; stage ignored web assets only" >&2
  exit 1
fi

# Snapshot packaging supports historical asset tags while always compiling
# the checked-out main source and ignored workspace web assets.
goreleaser release --snapshot --clean
