#!/bin/sh
#MISE description="Upload experimental desktop assets to an existing matching release"
#MISE tools={ "aqua:cli/cli" = "2.103.0" }
set -eu
: "${RELEASE_TAG:?RELEASE_TAG is required}"
: "${DIFFX_SOURCE_SHA:?DIFFX_SOURCE_SHA is required}"
fail() { printf 'desktop publish: %s\n' "$*" >&2; exit 1; }
[ "$(git rev-parse HEAD)" = "$DIFFX_SOURCE_SHA" ] || fail 'checkout does not match source'
[ "$(git rev-parse "refs/tags/$RELEASE_TAG^{commit}")" = "$DIFFX_SOURCE_SHA" ] || fail 'release tag does not match source'
version=${RELEASE_TAG#v}
out=apps/desktop/build/release
if command -v sha256sum >/dev/null 2>&1; then hash_tool=sha256sum
else hash_tool=shasum; fi
for target in darwin_amd64 darwin_arm64 linux_amd64 linux_arm64; do
  archive=diffx-desktop_${version}_${target}.tar.gz
  [ -s "$out/$archive" ] && [ -s "$out/$archive.sha256" ] || fail "missing $archive or checksum"
  expected=$(awk -v archive="$archive" '
    NR == 1 && NF == 2 && $2 == archive && length($1) == 64 && $1 ~ /^[[:xdigit:]]+$/ { hash = tolower($1) }
    END { if (NR != 1 || hash == "") exit 1; print hash }
  ' "$out/$archive.sha256") || fail "invalid checksum for $archive"
  if [ "$hash_tool" = sha256sum ]; then digest=$(sha256sum < "$out/$archive")
  else digest=$(shasum -a 256 < "$out/$archive"); fi
  [ "${digest%% *}" = "$expected" ] || fail "checksum mismatch for $archive"
done
cat "$out"/diffx-desktop_"$version"_*.tar.gz.sha256 > "$out/desktop-checksums.txt"
assets=$(gh release view "$RELEASE_TAG" --json assets --jq '.assets[].name')
present=0
for asset in desktop-checksums.txt diffx-desktop_"$version"_darwin_amd64.tar.gz diffx-desktop_"$version"_darwin_arm64.tar.gz diffx-desktop_"$version"_linux_amd64.tar.gz diffx-desktop_"$version"_linux_arm64.tar.gz; do
  if printf '%s\n' "$assets" | grep -Fxq "$asset"; then present=$((present + 1)); fi
done
if [ "$present" = 5 ]; then printf '%s\n' 'desktop artifacts already published; preserving stable assets'; exit 0; fi
[ "$present" = 0 ] || fail 'partial stable desktop publication; inspect assets before retrying'
gh release upload "$RELEASE_TAG" "$out"/diffx-desktop_"$version"_*.tar.gz
gh release upload "$RELEASE_TAG" "$out/desktop-checksums.txt"
