#!/usr/bin/env bash
#MISE description="Open or update the Homebrew tap pull request"
#MISE tools={ "aqua:cli/cli" = "2.103.0" }

set -euo pipefail

version="${RELEASE_VERSION:?RELEASE_VERSION is required}"
tag="${RELEASE_TAG:?RELEASE_TAG is required}"
# One rolling branch, so a release that lands before the previous pull request
# is merged rewrites that request instead of opening a superseded one.
branch="diffx-homebrew"
tap_repo="flexdinesh/homebrew-tap"

cd homebrew-tap
git config user.name "github-actions[bot]"
git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
git checkout -B "$branch"

if [[ -z "$(git status --porcelain -- Formula/diffx.rb)" ]]; then
  echo "Homebrew formula is already current for diffx v${version}."
  exit 0
fi

git add Formula/diffx.rb
git commit -m "Update diffx to v${version}"

# The lease names the remote value explicitly because the tap checkout fetches
# only main, leaving no remote-tracking ref for the branch to compare against.
# An empty expected value requires the branch to not exist yet.
remote_sha="$(git ls-remote --heads origin "refs/heads/${branch}" | cut -f1)"
git push --force-with-lease="refs/heads/${branch}:${remote_sha}" origin "HEAD:refs/heads/${branch}"

pr_number="$(gh pr list \
  --repo "$tap_repo" \
  --head "$branch" \
  --state open \
  --json number \
  --jq '.[0].number // ""')"

pr_body="$(mktemp)"
cat > "$pr_body" <<EOF
Updates the diffx formula to v${version}.

Source release: https://github.com/flexdinesh/diffx/releases/tag/${tag}

Each diffx release rewrites the \`${branch}\` branch, so this pull request always
tracks the newest released version. Generated by the diffx release workflow.
EOF

if [[ -n "$pr_number" ]]; then
  gh pr edit "$pr_number" \
    --repo "$tap_repo" \
    --title "Update diffx to v${version}" \
    --body-file "$pr_body"
else
  gh pr create \
    --repo "$tap_repo" \
    --head "$branch" \
    --base main \
    --title "Update diffx to v${version}" \
    --body-file "$pr_body"
fi
