{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "never" }
    ],
    "import/no-cycle": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "import/default": "off",
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/use-memo": "off"
  },
  "overrides": [
    {
      "files": ["apps/web/test/browser/**"],
      "rules": { "react/rules-of-hooks": "off" }
    },
    {
      "files": ["apps/web/src/**/*.tsx"],
      "rules": {
        "react/forbid-elements": [
          "error",
          {
            "forbid": [
              {
                "element": "button",
                "message": "use Button, IconButton or ListRow from @/components"
              },
              {
                "element": "input",
                "message": "use Input, SearchField or Checkbox from @/components"
              },
              {
                "element": "select",
                "message": "use Select from @/components/ui/select"
              },
              {
                "element": "textarea",
                "message": "use Textarea from @/components/ui/textarea"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/components/**"],
      "rules": { "react/forbid-elements": "off" }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/.agents/**"]
}
